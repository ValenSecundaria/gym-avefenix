{
  "name": "gym-avefenix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "demo:seed": "node --env-file=.env scripts/demo-data/seed.mjs",
    "demo:clear": "node --env-file=.env scripts/demo-data/clear.mjs",
    "pwa:icons": "node scripts/pwa/generate-icons.mjs",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup/backup-db.ps1",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/start-server.ps1",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.2.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
